<section>
  <div class="flex justify-center">
    <span class="-mt-px flex items-center gap-2 border-t border-gray-900 py-3 text-xs font-semibold uppercase tracking-widest">
      <i class="fa-solid fa-table-cells"></i> Posts
    </span>
  </div>

  <% posts = user.posts.order(created_at: :desc).with_attached_images.includes(:likes, :comments) %>
  <% if posts.empty? %>
    <p class="py-16 text-center text-sm text-gray-500">No posts yet.</p>
  <% else %>
    <div class="grid grid-cols-3 gap-1 sm:gap-4">
      <% posts.each do |post| %>
        <%= link_to post, class: "group relative block aspect-square overflow-hidden bg-gray-100" do %>
          <%= image_tag post.images.first, class: "h-full w-full object-cover" if post.images.attached? %>
          <% if post.images.size > 1 %>
            <i class="fa-solid fa-images absolute right-2 top-2 text-white drop-shadow"></i>
          <% end %>
          <div class="absolute inset-0 hidden items-center justify-center gap-6 bg-black/40 font-semibold text-white group-hover:flex">
            <span><i class="fa-solid fa-heart"></i> <%= post.likes.size %></span>
            <span><i class="fa-solid fa-comment fa-flip-horizontal"></i> <%= post.comments.size %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
