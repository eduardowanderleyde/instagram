<div class="flex items-center justify-between gap-3">
  <%= link_to suggestion, class: "flex min-w-0 items-center gap-3", data: { turbo: false } do %>
    <%= avatar_tag suggestion, size: "w-9 h-9" %>
    <div class="min-w-0 text-sm">
      <p class="truncate font-semibold"><%= suggestion.username %></p>
      <p class="truncate text-xs text-gray-500">Suggested for you</p>
    </div>
  <% end %>

  <% if current_user.waiting_followings.include?(suggestion) %>
    <%= button_to "Requested", cancel_request_path(user_id: suggestion.id), method: :delete,
          class: "btn-link text-xs font-semibold text-gray-500", data: { turbo: false } %>
  <% else %>
    <%= button_to "Follow", follow_path(user_id: suggestion.id), method: :post,
          class: "btn-link text-xs font-semibold", data: { turbo: false } %>
  <% end %>
</div>
