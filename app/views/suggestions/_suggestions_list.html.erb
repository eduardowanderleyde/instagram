<div class="flex flex-col gap-4">
  <div class="flex items-center gap-3">
    <%= link_to current_user do %>
      <%= avatar_tag current_user, size: "w-11 h-11" %>
    <% end %>
    <div class="min-w-0 text-sm">
      <%= link_to current_user.username, current_user, class: "block truncate font-semibold" %>
      <p class="truncate text-gray-500"><%= current_user.full_name %></p>
    </div>
  </div>

  <div class="flex items-center justify-between text-sm">
    <p class="font-semibold text-gray-500">Suggestions for you</p>
  </div>

  <div class="flex flex-col gap-3">
    <% suggestions.each do |suggestion| %>
      <%= render "suggestions/suggestion", suggestion: suggestion %>
    <% end %>
  </div>
</div>
