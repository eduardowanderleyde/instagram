<% unless post.nil? %>
  <article class="card" id="<%= dom_id post %>" data-controller="like">
    <%# Cabeçalho com usuário %>
    <header class="flex items-center justify-between px-4 py-3">
      <%= link_to post.user, class: "flex items-center gap-3" do %>
        <%= avatar_tag post.user, size: "w-9 h-9" %>
        <span class="text-sm font-semibold hover:underline"><%= post.user.username %></span>
      <% end %>
      <% if current_user == post.user %>
        <%= button_to "Excluir", post, method: :delete, class: "text-sm text-red-500 hover:underline",
              form: { data: { turbo_confirm: "Excluir este post?" } } %>
      <% end %>
    </header>

    <%# Imagens (carrossel quando houver mais de uma); duplo clique curte %>
    <% if post.images.attached? %>
      <div class="relative bg-black" data-controller="carousel" data-action="dblclick->like#like">
        <% post.images.each do |image| %>
          <%= image_tag image, class: "max-h-[36rem] w-full object-contain", data: { carousel_target: "slide" } %>
        <% end %>
        <% if post.images.size > 1 %>
          <button type="button" class="absolute left-2 top-1/2 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-sm shadow"
                  aria-label="Previous" data-carousel-target="prev" data-action="carousel#previous">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <button type="button" class="absolute right-2 top-1/2 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-sm shadow"
                  aria-label="Next" data-carousel-target="next" data-action="carousel#next">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
          <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-1">
            <% post.images.size.times do %>
              <span class="h-1.5 w-1.5 rounded-full bg-gray-300" data-carousel-target="dot"></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-col gap-1 px-4 py-3 text-sm">
      <%= render "posts/post_actions", post: post %>
      <p><%= link_to post.user.username, post.user, class: "font-semibold" %> <%= post.caption %></p>
      <%= render "posts/post_comments", post: post %>
      <time class="text-xs uppercase text-gray-500" datetime="<%= post.created_at.iso8601 %>">
        <%= time_ago_in_words(post.created_at) %> ago
      </time>
    </div>

    <%# Formulário de comentário (visitante vê link para o login) %>
    <% if current_user %>
      <%= form_with url: comments_path, method: :post, class: "border-t border-gray-200",
            data: { controller: "comments", action: "turbo:submit-end->comments#clear" } do |f| %>
        <div class="flex items-center gap-2 px-4 py-2">
          <%= f.hidden_field :post_id, value: post.id %>
          <%= f.text_area :comment_body, rows: 1, placeholder: "Adicione um comentário...", required: true,
                id: dom_id(post, :comment_body), class: "flex-1 resize-none border-0 px-0 text-sm focus:ring-0" %>
          <%= f.submit "Postar", class: "btn-link text-sm font-semibold" %>
        </div>
      <% end %>
    <% else %>
      <div class="border-t border-gray-200 px-4 py-3 text-sm text-gray-500">
        <%= link_to "Entre", new_user_session_path, class: "font-semibold text-blue-500" %> para curtir e comentar.
      </div>
    <% end %>
  </article>
<% end %>
