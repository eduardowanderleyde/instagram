<%= turbo_frame_tag "post#{post.id}actions" do %>
  <div data-controller="modal">
    <div class="flex items-center gap-4 text-2xl">
      <% if current_user %>
        <%= button_to toggle_like_path(post_id: post.id), method: :post, class: "hover:opacity-60",
              id: "post#{post.id}actions-likeBtn", "aria-label": "Like", data: { like_target: "button" } do %>
          <% if post.likes.any? { |like| like.user_id == current_user.id } %>
            <i class="fa-solid fa-heart text-red-500"></i>
          <% else %>
            <i class="fa-regular fa-heart"></i>
          <% end %>
        <% end %>
        <label for="<%= dom_id(post, :comment_body) %>" class="cursor-pointer hover:opacity-60" aria-label="Comment">
          <i class="fa-regular fa-comment fa-flip-horizontal"></i>
        </label>
      <% else %>
        <%# Visitante: leva ao login fora do turbo-frame (senão o Turbo mostra "Content missing") %>
        <%= link_to new_user_session_path, class: "hover:opacity-60", "aria-label": "Log in to like", data: { turbo_frame: "_top" } do %>
          <i class="fa-regular fa-heart"></i>
        <% end %>
        <%= link_to new_user_session_path, class: "hover:opacity-60", "aria-label": "Log in to comment", data: { turbo_frame: "_top" } do %>
          <i class="fa-regular fa-comment fa-flip-horizontal"></i>
        <% end %>
      <% end %>
    </div>

    <button type="button" class="mt-1 text-sm font-semibold" data-action="modal#open">
      <%= pluralize(post.likes.size, "like") %>
    </button>

    <dialog class="modal" data-modal-target="dialog" data-action="click->modal#backdropClose">
      <div class="modal-header">
        <span>Likes</span>
        <button type="button" class="text-gray-500 hover:text-gray-900" aria-label="Close" data-action="modal#close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="flex max-h-96 flex-col gap-3 overflow-y-auto p-4">
        <% post.likers.each do |liker| %>
          <%= render "posts/liker", liker: liker %>
        <% end %>
        <% if post.likes.empty? %>
          <p class="text-sm text-gray-500">No likes yet.</p>
        <% end %>
      </div>
    </dialog>
  </div>
<% end %>
