<div id="post<%= comment.post_id %>ModalComment<%= comment.id %>" class="flex items-start justify-between gap-3">
  <div class="flex min-w-0 items-start gap-3">
    <%= avatar_tag comment.user, size: "w-8 h-8" %>
    <div class="min-w-0 text-sm">
      <p class="break-words">
        <%= link_to comment.user.username, comment.user, class: "font-semibold", data: { turbo: false } %>
        <%= comment.body %>
      </p>
      <p class="text-xs text-gray-500"><%= time_ago_in_words(comment.created_at) %> ago</p>
    </div>
  </div>
  <% if comment.user == current_user %>
    <%= button_to comment_path(id: comment.id), method: :delete, class: "text-gray-400 hover:text-red-500", "aria-label": "Delete comment" do %>
      <i class="fa-solid fa-xmark"></i>
    <% end %>
  <% end %>
</div>
