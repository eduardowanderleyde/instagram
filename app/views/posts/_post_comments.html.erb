<%= turbo_frame_tag "post#{post.id}comments" do %>
  <div data-controller="modal">
    <% if post.comments.size > 5 %>
      <button type="button" class="text-gray-500" data-action="modal#open">
        View all <%= pluralize(post.comments.size, "comment") %>
      </button>
    <% end %>
    <% post.comments.last(5).each do |comment| %>
      <p><%= link_to comment.user.username, comment.user, class: "font-semibold", data: { turbo: false } %> <%= comment.body %></p>
    <% end %>

    <dialog class="modal" data-modal-target="dialog" data-action="click->modal#backdropClose">
      <div class="modal-header">
        <span>Comments</span>
        <button type="button" class="text-gray-500 hover:text-gray-900" aria-label="Close" data-action="modal#close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="flex max-h-[28rem] flex-col gap-4 overflow-y-auto p-4">
        <% post.comments.each do |comment| %>
          <%= render "posts/modal_comment", comment: comment %>
        <% end %>
      </div>
    </dialog>
  </div>
<% end %>
