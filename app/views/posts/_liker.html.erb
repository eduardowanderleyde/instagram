<div class="flex items-center justify-between gap-3">
  <%= link_to liker, class: "flex min-w-0 items-center gap-3", data: { turbo: false } do %>
    <%= avatar_tag liker, size: "w-9 h-9" %>
    <span class="truncate text-sm font-semibold"><%= liker.username %></span>
  <% end %>
  <% if current_user %>
    <%= render "layouts/shared/follow_state", user: liker %>
  <% end %>
</div>
