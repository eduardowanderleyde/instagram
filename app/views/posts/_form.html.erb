<%= form_with(model: post) do |form| %>
  <div class="flex flex-col md:flex-row">
    <div class="p-4 md:w-3/5 md:border-r md:border-gray-200">
      <%= form.file_field :images, multiple: true, class: "filepond", accept: "image/*", required: post.new_record? %>
    </div>

    <div class="flex flex-col gap-3 p-4 md:w-2/5">
      <% if post.errors.any? %>
        <ul class="rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800">
          <% post.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      <% end %>

      <div class="flex items-center gap-2">
        <%= avatar_tag current_user, size: "w-8 h-8" %>
        <span class="text-sm font-semibold"><%= current_user.username %></span>
      </div>

      <%= form.text_area :caption, rows: 6, placeholder: "Write a caption...", class: "input resize-none border-0 bg-transparent px-0" %>

      <details class="group rounded-md border border-gray-200 text-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2 font-medium">
          Advanced settings
          <i class="fa-solid fa-chevron-down transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="flex flex-col gap-2 border-t border-gray-200 px-3 py-2">
          <label class="flex items-center justify-between gap-2">
            Allow comments
            <%= form.check_box :allow_comments, checked: post.new_record? || post.allow_comments, class: "rounded text-blue-500 focus:ring-0" %>
          </label>
          <label class="flex items-center justify-between gap-2">
            Show likes count
            <%= form.check_box :show_likes_count, checked: post.new_record? || post.show_likes_count, class: "rounded text-blue-500 focus:ring-0" %>
          </label>
        </div>
      </details>

      <div class="mt-auto flex justify-end">
        <%= form.submit post.new_record? ? "Share" : "Save", class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>
