<%= turbo_frame_tag "search_results" do %>
  <ul class="flex flex-col">
    <% users.each do |u| %>
      <li>
        <%= link_to u, class: "flex items-center gap-3 rounded-md px-2 py-2 hover:bg-gray-100", data: { turbo: false } do %>
          <%= avatar_tag u, size: "w-9 h-9" %>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold"><%= u.username %></p>
            <p class="truncate text-xs text-gray-500"><%= u.full_name %></p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if users.empty? %>
    <p class="px-2 py-3 text-sm text-gray-500">
      <%= params[:search_query].present? ? "No results found." : "Type to search users." %>
    </p>
  <% end %>
<% end %>
