<nav class="sticky top-0 z-40 border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-2">
    <%= link_to root_path, class: "shrink-0" do %>
      <%= image_tag "logo.jpeg", alt: "Instagram", class: "h-9 w-auto" %>
    <% end %>

    <%# Busca de usuários %>
    <div class="relative hidden w-64 sm:block" data-controller="dropdown"
         data-action="click@window->dropdown#hide keydown->dropdown#closeOnEscape">
      <%= form_with url: users_path, method: :get, data: { turbo_frame: "search_results", controller: "search-results" } do |f| %>
        <%= f.search_field :search_query, placeholder: "Search", autocomplete: "off", "aria-label": "Search",
              class: "input border-0 bg-gray-100",
              data: { action: "input->search-results#search focus->dropdown#open" } %>
      <% end %>
      <div class="absolute left-0 right-0 mt-2 hidden max-h-96 overflow-y-auto card p-2 shadow-lg" data-dropdown-target="menu">
        <%= render "layouts/search_results", users: [] %>
      </div>
    </div>

    <div class="flex items-center gap-5 text-xl">
      <%= link_to root_path, class: "hover:text-gray-500", title: "Home" do %>
        <i class="fa-solid fa-house"></i>
      <% end %>

      <%# Novo post %>
      <div data-controller="modal">
        <button type="button" class="hover:text-gray-500" title="New post" data-action="modal#open">
          <i class="fa-regular fa-square-plus"></i>
        </button>
        <dialog class="modal max-w-3xl" data-modal-target="dialog" data-action="click->modal#backdropClose">
          <div class="modal-header">
            <span>Create new post</span>
            <button type="button" class="text-gray-500 hover:text-gray-900" aria-label="Close" data-action="modal#close">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          <%= render "posts/form", post: Post.new %>
        </dialog>
      </div>

      <%# Pedidos de follow %>
      <% follow_requests = current_user.follow_requests.includes(follower: { profile_pic_attachment: :blob }) %>
      <div class="relative" data-controller="dropdown"
           data-action="click@window->dropdown#hide keydown->dropdown#closeOnEscape">
        <button type="button" class="relative hover:text-gray-500" title="Follow requests" data-action="dropdown#toggle">
          <i class="fa-regular fa-heart"></i>
          <% if follow_requests.any? %>
            <span class="absolute -right-2 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">
              <%= follow_requests.size %>
            </span>
          <% end %>
        </button>
        <div class="absolute right-0 mt-3 hidden w-80 card p-3 text-sm shadow-lg" data-dropdown-target="menu">
          <p class="mb-2 font-semibold">Follow requests</p>
          <ul class="flex flex-col gap-3">
            <% follow_requests.each do |fr| %>
              <li class="flex items-center justify-between gap-2">
                <%= link_to fr.follower, class: "flex min-w-0 items-center gap-2" do %>
                  <%= avatar_tag fr.follower, size: "w-9 h-9" %>
                  <span class="truncate font-semibold"><%= fr.follower.username %></span>
                <% end %>
                <div class="flex shrink-0 gap-1">
                  <%= button_to "Accept", accept_follow_path(follow_id: fr.id), method: :post, class: "btn btn-primary px-3" %>
                  <%= button_to "Decline", decline_follow_path(follow_id: fr.id), method: :delete, class: "btn btn-secondary px-3" %>
                </div>
              </li>
            <% end %>
          </ul>
          <% if follow_requests.empty? %>
            <p class="text-gray-500">No pending requests.</p>
          <% end %>
        </div>
      </div>

      <%# Menu do perfil %>
      <div class="relative" data-controller="dropdown"
           data-action="click@window->dropdown#hide keydown->dropdown#closeOnEscape">
        <button type="button" class="flex" title="Profile" data-action="dropdown#toggle">
          <%= avatar_tag current_user, size: "w-7 h-7" %>
        </button>
        <div class="absolute right-0 mt-3 hidden w-44 card py-1 text-sm shadow-lg" data-dropdown-target="menu">
          <%= link_to "Profile", user_path(current_user), class: "block px-4 py-2 hover:bg-gray-100" %>
          <%= link_to "Settings", edit_user_registration_path, class: "block px-4 py-2 hover:bg-gray-100" %>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete,
                class: "block w-full px-4 py-2 text-left hover:bg-gray-100", data: { turbo: false } %>
        </div>
      </div>
    </div>
  </div>
</nav>
