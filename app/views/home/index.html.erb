<main class="mx-auto flex max-w-5xl justify-center gap-8 px-4 py-6">
  <section class="flex w-full max-w-lg flex-col gap-6">
    <%= render "story/stories_list" %>

    <% @posts.each do |p| %>
      <%= render "posts/post", post: p %>
    <% end %>

    <% if @posts.empty? %>
      <div class="card px-6 py-10 text-center text-sm text-gray-500">
        No posts yet. Follow people or share your first photo.
      </div>
    <% end %>

    <div class="flex justify-center">
      <%= paginate @posts %>
    </div>
  </section>

  <% if @suggestions.present? %>
    <aside class="hidden w-80 shrink-0 lg:block">
      <div class="sticky top-20">
        <%= render "suggestions/suggestions_list", suggestions: @suggestions %>
      </div>
    </aside>
  <% end %>
</main>
