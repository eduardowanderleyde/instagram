<main class="mx-auto max-w-3xl px-4 py-8">
  <div class="card flex flex-col md:flex-row">
    <nav class="border-b border-gray-200 md:w-48 md:border-b-0 md:border-r">
      <span class="block border-l-2 border-gray-900 bg-gray-50 px-4 py-3 text-sm font-semibold">Edit profile</span>
    </nav>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-1 flex-col gap-5 p-6 md:p-8" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="flex items-center gap-4">
        <%= avatar_tag resource, size: "w-14 h-14" %>
        <div class="min-w-0 flex-1">
          <p class="truncate font-semibold"><%= resource.username %></p>
          <%= f.file_field :profile_pic, accept: "image/*",
                class: "mt-1 block w-full text-xs file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-3 file:py-1.5 file:font-semibold hover:file:bg-gray-200" %>
        </div>
      </div>

      <label class="flex items-center gap-2 text-sm font-semibold">
        <%= f.check_box :private, class: "rounded text-blue-500 focus:ring-0" %>
        Private account
      </label>

      <% fields = [
           [:full_name, :text_field, "Help people discover your account by using the name you're known by."],
           [:username, :text_field, nil],
           [:bio, :text_area, nil],
           [:email, :email_field, nil],
           [:phone_number, :text_field, nil],
           [:password, :password_field, "Leave it blank if you don't want to change it."],
           [:password_confirmation, :password_field, nil],
           [:current_password, :password_field, "Current password required to save changes."]
         ] %>
      <% fields.each do |attribute, field_type, hint| %>
        <div class="grid gap-1 sm:grid-cols-3 sm:gap-4">
          <%= f.label attribute, attribute == :password ? "New password" : nil, class: "text-sm font-semibold sm:pt-2 sm:text-right" %>
          <div class="sm:col-span-2">
            <% if field_type == :text_area %>
              <%= f.text_area attribute, rows: 4, class: "input" %>
            <% else %>
              <%= f.public_send field_type, attribute, class: "input", autocomplete: (field_type == :password_field ? "new-password" : nil) %>
            <% end %>
            <% if hint %>
              <p class="mt-1 text-xs text-gray-500"><%= hint %></p>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex justify-end">
        <%= f.submit "Submit", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</main>
