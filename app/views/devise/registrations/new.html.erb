<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-3 px-4 py-8">
  <div class="card flex flex-col items-center gap-4 px-10 py-8">
    <%= image_tag "logo.jpeg", alt: "Instagram", class: "w-44" %>
    <p class="text-center font-semibold text-gray-500">Sign up to see photos and videos from your friends.</p>

    <a href="#" class="btn btn-primary w-full">
      <%= image_tag "facebook.jpeg", alt: "", class: "w-4" %>
      Log in with Facebook
    </a>

    <div class="divider-or w-full">or</div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex w-full flex-col gap-2" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "Email", class: "input" %>
      <%= f.text_field :full_name, autocomplete: "name", placeholder: "Full Name", class: "input" %>
      <%= f.text_field :username, autocomplete: "username", placeholder: "Username", class: "input" %>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password", class: "input" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Password Confirmation", class: "input" %>
      <%= f.submit "Sign up", class: "btn btn-primary mt-2 w-full" %>
    <% end %>
  </div>

  <div class="card px-10 py-5 text-center text-sm">
    Have an account?
    <%= link_to "Log in", new_user_session_path, class: "font-semibold text-blue-500" %>
  </div>
</main>
